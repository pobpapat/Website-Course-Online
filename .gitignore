# Root ignore for repository

# Environment files
.env

# OS & editor files
.DS_Store
.vscode/
.idea/

# Docker temporary files
**/.dockerignore

# Backend
/backend/uploads/
/backend/*.log
/backend/*.exe
/backend/*.out
/backend/*.test

# Frontend
/frontend/node_modules/
/frontend/dist/
/frontend/*.log
/frontend/*.test

# General
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
